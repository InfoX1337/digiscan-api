{
  "name": "formproof",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src test",
    "web:dev": "vite web",
    "web:build": "vite build web",
    "license:check": "node scripts/license-check.mjs",
    "eval": "tsx scripts/eval/run.ts"
  },
  "dependencies": {
    "@fastify/jwt": "^10.2.8",
    "@fastify/multipart": "^10.1.9",
    "@fastify/static": "^10.1.12",

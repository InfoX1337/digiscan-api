    "@fastify/swagger-ui": "^6.1.4",
    "@napi-rs/canvas": "^1.1.1",
    "ajv": "^8.20.0",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.12.1",
    "fastify": "^5.12.8",
    "fflate": "^0.8.3",
    "file-type": "^22.3.0",
    "jsonata": "^2.2.2",
    "pdfjs-dist": "^6.5.438",
    "pino": "^10.4.0",
    "tesseract.js": "^7.0.0",
    "word-extractor": "^1.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"

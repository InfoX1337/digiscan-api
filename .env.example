APP_ENV=demo
PORT=8000
LOG_LEVEL=info
# Uwierzytelnianie JWT wyłączone (demo). AUTH_ENABLED=true włącza Bearer na API.
AUTH_ENABLED=false
# JWT (HS256) – min. 32 znaki, wymagany w produkcji przy AUTH_ENABLED=true
JWT_SECRET=change-me-to-a-long-random-string-32chars+
JWT_EXPIRES_S=3600
JWT_ISSUER=formproof
JWT_AUDIENCE=formproof-api
# klient API (POST /api/v1/auth/token)
AUTH_CLIENT_ID=demo
AUTH_CLIENT_SECRET=demo-secret
# limity
MAX_FILE_BYTES=15728640
MAX_BATCH_FILES=10
MAX_BATCH_BYTES=52428800
MAX_OCR_PAGES=5
REQUEST_TIMEOUT_S=180
# LLM lokalny (open weights). Na Macu szybciej: OLLAMA_URL=http://host.docker.internal:11434
LLM_ENABLED=true
OLLAMA_URL=http://ollama:11434
LLM_MODEL=qwen3.5:4b
LLM_TIMEOUT_S=100
TESSERACT_CMD=tesseract
# UI w trybie demo pobiera krótki token (APP_ENV=production wymusza DEMO_UI=false i własne sekrety)
DEMO_UI=true
